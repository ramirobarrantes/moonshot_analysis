#!/usr/bin/env bash
# Per-patient run configuration. Copy to run_<PATIENT>.conf and edit.
# Sourced by orchestration/run_pipeline.sh

# ── Patient / samples ─────────────────────────────────────────────────────────
PATIENT=MS008

NORMAL_SAMPLE=MS008_NORMAL
NORMAL_FASTQ_1=/netfiles/moonshot/raw_data/MS008/TL-26-SJ6H8MY3SL/TL-26-SJ6H8MY3SL_N_DSQ1_1.fastq.gz
NORMAL_FASTQ_2=/netfiles/moonshot/raw_data/MS008/TL-26-SJ6H8MY3SL/TL-26-SJ6H8MY3SL_N_DSQ1_2.fastq.gz

# Parallel arrays — one entry per tumor sample
TUMOR_SAMPLES=(MS008_TUMOR MS008_TUMOR2)
TUMOR_FASTQ_1=(
  /netfiles/moonshot/raw_data/MS008/TL-26-SJ6H8MY3SL/TL-26-SJ6H8MY3SL_T_DSQ1_1.fastq.gz
  /netfiles/moonshot/raw_data/MS008/TL-26-JWZIOEX856/TL-26-JWZIOEX856_T_CSQ1_1.fastq.gz
)
TUMOR_FASTQ_2=(
  /netfiles/moonshot/raw_data/MS008/TL-26-SJ6H8MY3SL/TL-26-SJ6H8MY3SL_T_DSQ1_2.fastq.gz
  /netfiles/moonshot/raw_data/MS008/TL-26-JWZIOEX856/TL-26-JWZIOEX856_T_CSQ1_2.fastq.gz
)

# ── Output / work directories ─────────────────────────────────────────────────
BASE_OUTDIR=/netfiles/davidkragseqdata/moonshot_run_output/${PATIENT}
SEQINSPECTOR_OUTDIR=${BASE_OUTDIR}/seqinspector
SAREK_OUTDIR=${BASE_OUTDIR}/sarek_output
MOONSHOT_PIPELINE_OUTDIR=${BASE_OUTDIR}/moonshotAnalysis
ANALYSIS_OUTDIR=${BASE_OUTDIR}/finalAnalysis

WORKDIR=/users/r/b/rbarrant/scratch/nfcorework

# ── Repos ──────────────────────────────────────────────────────────────────────
MOONSHOT_DB_REPO=/users/r/b/rbarrant/projects/moonshot/moonshot_pipeline_db
MOONSHOT_PIPELINE_REPO=/users/r/b/rbarrant/projects/moonshot/moonshot_pipeline
MOONSHOT_ANALYSIS_REPO=/users/r/b/rbarrant/projects/moonshot/moonshot_pipeline_analysis
SEQINSPECTOR_REPO=/users/r/b/rbarrant/projects/moonshot/seqinspector

# ── seqinspector inputs ────────────────────────────────────────────────────────
FASTQ_SCREEN_REFERENCES=~/projects/moonshot/moonshot/fastq_genome_samplesheet.csv

# ── Reference genome ───────────────────────────────────────────────────────────
FASTA=/users/r/b/rbarrant/projects/moonshot/genomes/GATK_GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta
FAI=${FASTA}.fai
DICT=/users/r/b/rbarrant/projects/moonshot/genomes/GATK_GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.dict
# TODO: confirm actual dbsnp / ichorCNA wig paths used in your runs
DBSNP=/users/r/b/rbarrant/projects/moonshot/genomes/GATK_GRCh38/Annotation/GATKBundle/dbsnp.vcf.gz
DBSNP_TBI=${DBSNP}.tbi
GC_WIG=/users/r/b/rbarrant/projects/moonshot/genomes/ichorcna/gc_hg38.wig
MAP_WIG=/users/r/b/rbarrant/projects/moonshot/genomes/ichorcna/map_hg38.wig
GERMLINE_VCF=/users/r/b/rbarrant/projects/moonshot/genomes/GATK_GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz
GERMLINE_VCF_TBI=${GERMLINE_VCF}.tbi
CONTAMINATION_VCF=/users/r/b/rbarrant/projects/moonshot/genomes/GATK_GRCh38/small_exac_common_3.hg38.vcf.gz
CONTAMINATION_VCF_TBI=${CONTAMINATION_VCF}.tbi
HET_PON=/users/r/b/rbarrant/projects/moonshot/genomes/purple/GermlineHetPon.38.vcf.gz
HET_PON_TBI=${HET_PON}.tbi
GC_PROFILE=/users/r/b/rbarrant/projects/moonshot/genomes/purple/GC_profile.1000bp.38.cnp
ENSEMBL_DATA_DIR=/users/r/b/rbarrant/projects/genomes/purple/hmf_pipeline_resources.38_v2.3.0--2/common/ensembl_data/

# ── VEP ─────────────────────────────────────────────────────────────────────────
VEP_CACHE=/users/r/b/rbarrant/.vep
VEP_CACHE_VERSION=114

# ── moonshot DB pipeline outputs (feeds moonshot_analysis) ─────────────────────
# ensembl_peptides/ and uniprot_database/ are (re)generated by the DB pipeline.
# The cosmic DB is not produced by the DB pipeline — it must already exist here
# (downloaded/added manually) before moonshot_analysis runs.
DB_OUTDIR=/users/r/b/rbarrant/projects/moonshot/dbs
ENSEMBL_VERSION=114
ENSEMBL_PEPTIDES_DB=${DB_OUTDIR}/ensembl_peptides/ensembl_peptides.csv
UNIPROT_DB=${DB_OUTDIR}/uniprot_database/HUMAN_9606_Database.RDS
COSMIC_DB=${DB_OUTDIR}/Cosmic_MutantCensus_Tsv_v104_GRCh37/Cosmic_MutantCensus_v104_GRCh37.tsv

# ── Sarek / seqinspector params ─────────────────────────────────────────────────
SAREK_VERSION=3.9.0
SAREK_TOOLS=mutect2,strelka,vep
SAREK_GENOME=GATK.GRCh38
SEQINSPECTOR_VERSION=1.1.0

# ── Docker image for final analysis ─────────────────────────────────────────────
ANALYSIS_DOCKER_IMAGE=moonshot-analysis:latest
